{
  "name": "akhtar-agent",
  "productName": "Akhtar Agent",
  "version": "1.0.0-alpha.1",
  "description": "Akhtar Agent — Electron desktop AI agent framework (AI coworker with controlled tools)",
  "main": "src/main/main.js",
  "author": "Akhtar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/**/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "test:stability": "node --test \"tests/stability-*.test.js\"",
    "soak": "node scripts/soak.js",
    "test:chaos": "node --test tests/bughunt-chaos-soak.test.js",
    "test:ui": "python tests/ui/ui_check.py"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "chart.js": "^4.4.7",
    "javascript-obfuscator": "^4.1.1"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.akhtar.agent",
    "productName": "Akhtar Agent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "skills/**/*",
      "os/**/*",
      "plugins/**/*",
      "package.json",
      "!README.md"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
